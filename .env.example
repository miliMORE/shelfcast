# Database (Postgres)
DATABASE_URL="postgresql://shelfcast:shelfcast@localhost:5432/shelfcast?schema=public"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Public app URL (Stripe redirects, absolute links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# TTS
# Free plan always uses mock. Pro requires openai + OPENAI_API_KEY (no silent mock fallback).
TTS_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_TTS_VOICE="alloy"
OPENAI_TTS_MODEL="tts-1"

# Storage: local | s3
STORAGE_DRIVER="local"
STORAGE_ROOT="storage"

# S3-compatible (R2 / MinIO / AWS) when STORAGE_DRIVER=s3
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="shelfcast"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"
# Optional public base for signedOrPublicUrl
# S3_PUBLIC_URL_BASE=

# Worker
# PROCESS_JOBS=0 disables claiming (web-only debug). Omit or set 1 for normal worker.
WORKER_POLL_MS=2000

# Stripe (optional for local mock demos)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
